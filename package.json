{
  "name": "vscode-dev-environments",
  "displayName": "Dev Environments",
  "description": "Open your GitHub repositories in local dev containers with one action.",
  "version": "0.1.0",
  "publisher": "nimblescape",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/vscode-dev-environments.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/vscode-dev-environments/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-containers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onResolveRemoteAuthority:attached-container"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devEnvironments",
          "title": "Dev Environments",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "devEnvironments": [
        {
          "id": "devEnvironments.repositories",
          "name": "Dev Environments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devEnvironments.repositories",
        "contents": "Dev Environments runs your environments in Docker, which is not installed on this computer.\n[Install Docker…](command:devEnvironments.installDocker)",
        "when": "devEnvironments.dockerMissing"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Sign in with GitHub to see your repositories that have a Dev Container configuration.\n[Sign in with GitHub](command:devEnvironments.signIn)",
        "when": "!devEnvironments.signedIn"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Loading your repositories…",
        "when": "devEnvironments.signedIn && !devEnvironments.loaded"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "No repository with a Dev Container configuration was found.\n[Refresh](command:devEnvironments.refresh)",
        "when": "devEnvironments.signedIn && devEnvironments.loaded && !devEnvironments.loadFailed"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "The repository list could not be loaded. Check the internet connection and try again.\n[Refresh](command:devEnvironments.refresh)\n[Show Log](command:devEnvironments.showLog)",
        "when": "devEnvironments.signedIn && devEnvironments.loadFailed"
      }
    ],
    "walkthroughs": [
      {
        "id": "dockerSetup",
        "title": "Set up Docker for Dev Environments",
        "description": "Dev Environments runs your environments in Docker. Install and start Docker, then sign in with GitHub.",
        "steps": [
          {
            "id": "wsl",
            "title": "Install WSL 2",
            "description": "Docker Desktop runs your environments in WSL 2, the Windows Subsystem for Linux. Windows asks for administrator permission, and the computer must restart afterwards.\n[Install WSL 2](command:devEnvironments.dockerSetup.installWsl)",
            "media": {
              "markdown": "resources/walkthrough/wsl.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.wslReady"
            ],
            "when": "isWindows"
          },
          {
            "id": "installMac",
            "title": "Install Docker",
            "description": "Installs Docker Desktop with Homebrew, or downloads its installer from Docker. You see the exact commands before anything runs.\n[Install Docker](command:devEnvironments.dockerSetup.install)",
            "media": {
              "markdown": "resources/walkthrough/install-mac.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.dockerInstalled"
            ],
            "when": "isMac"
          },
          {
            "id": "installWindows",
            "title": "Install Docker",
            "description": "Installs Docker Desktop with winget, or downloads its installer from Docker. You see the exact commands before anything runs.\n[Install Docker](command:devEnvironments.dockerSetup.install)",
            "media": {
              "markdown": "resources/walkthrough/install-windows.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.dockerInstalled"
            ],
            "when": "isWindows"
          },
          {
            "id": "installLinux",
            "title": "Install Docker",
            "description": "Installs Docker Engine from the package repository of Docker. You see the exact commands before anything runs.\n[Install Docker](command:devEnvironments.dockerSetup.install)",
            "media": {
              "markdown": "resources/walkthrough/install-linux.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.dockerInstalled"
            ],
            "when": "isLinux"
          },
          {
            "id": "startDesktop",
            "title": "Start Docker",
            "description": "Starts Docker Desktop and waits until it is ready. At its first start, Docker Desktop shows its own dialogs once.\n[Start Docker](command:devEnvironments.dockerSetup.start)",
            "media": {
              "markdown": "resources/walkthrough/start-desktop.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.dockerReady"
            ],
            "when": "isMac || isWindows"
          },
          {
            "id": "startLinux",
            "title": "Start Docker",
            "description": "Starts Docker and checks that it is ready. The Docker service is started in a terminal, where you enter your password.\n[Start Docker](command:devEnvironments.dockerSetup.start)",
            "media": {
              "markdown": "resources/walkthrough/start-linux.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.dockerReady"
            ],
            "when": "isLinux"
          },
          {
            "id": "signIn",
            "title": "Sign in with GitHub",
            "description": "Sign in with GitHub to see your repositories that have a Dev Container configuration.\n[Sign in with GitHub](command:devEnvironments.signIn)",
            "media": {
              "markdown": "resources/walkthrough/sign-in.md"
            },
            "completionEvents": [
              "onContext:devEnvironments.signedIn"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "devEnvironments.start",
        "title": "Start",
        "category": "Dev Environments",
        "icon": "$(play)"
      },
      {
        "command": "devEnvironments.startInNewWindow",
        "title": "Start in New Window",
        "category": "Dev Environments",
        "icon": "$(empty-window)"
      },
      {
        "command": "devEnvironments.startInCurrentWindow",
        "title": "Start in Current Window",
        "category": "Dev Environments",
        "icon": "$(play)"
      },
      {
        "command": "devEnvironments.stop",
        "title": "Stop",
        "category": "Dev Environments",
        "icon": "$(debug-stop)"
      },
      {
        "command": "devEnvironments.delete",
        "title": "Delete",
        "category": "Dev Environments",
        "icon": "$(trash)"
      },
      {
        "command": "devEnvironments.switchBranch",
        "title": "Switch Branch…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.selectConfiguration",
        "title": "Select Configuration…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.rebuild",
        "title": "Rebuild",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.showOnGitHub",
        "title": "Show on GitHub",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.switchEnvironment",
        "title": "Switch Environment…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.switchEnvironmentInNewWindow",
        "title": "Switch Environment in New Window…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.switchEnvironmentInCurrentWindow",
        "title": "Switch Environment in Current Window…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.refresh",
        "title": "Refresh",
        "category": "Dev Environments",
        "icon": "$(refresh)"
      },
      {
        "command": "devEnvironments.search",
        "title": "Search",
        "category": "Dev Environments",
        "icon": "$(search)"
      },
      {
        "command": "devEnvironments.showLog",
        "title": "Show Log",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.signIn",
        "title": "Sign in with GitHub",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.selectOwners",
        "title": "Select Organizations…",
        "category": "Dev Environments",
        "icon": "$(filter)"
      },
      {
        "command": "devEnvironments.selectOwnersFiltered",
        "title": "Select Organizations…",
        "category": "Dev Environments",
        "icon": "$(filter-filled)"
      },
      {
        "command": "devEnvironments.editRepositoryGroups",
        "title": "Edit Repository Groups…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.installDocker",
        "title": "Install Docker…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.turnOffHostAccessChecks",
        "title": "Turn Off Host Access Checks…",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.turnOnHostAccessChecks",
        "title": "Turn On Host Access Checks",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.dockerSetup.install",
        "title": "Install Docker",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.dockerSetup.start",
        "title": "Start Docker",
        "category": "Dev Environments"
      },
      {
        "command": "devEnvironments.dockerSetup.installWsl",
        "title": "Install WSL 2",
        "category": "Dev Environments"
      }
    ],
    "submenus": [
      {
        "id": "devEnvironments.more",
        "label": "More Actions",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "!config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.switchEnvironmentInNewWindow",
          "when": "!config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.switchEnvironmentInCurrentWindow",
          "when": "config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.selectOwnersFiltered",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.install",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.start",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.installWsl",
          "when": "false"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "false"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "devEnvironments.selectOwners",
          "when": "view == devEnvironments.repositories && !devEnvironments.ownersFiltered",
          "group": "navigation@0"
        },
        {
          "command": "devEnvironments.selectOwnersFiltered",
          "when": "view == devEnvironments.repositories && devEnvironments.ownersFiltered",
          "group": "navigation@0"
        },
        {
          "command": "devEnvironments.search",
          "when": "view == devEnvironments.repositories",
          "group": "navigation@1"
        },
        {
          "command": "devEnvironments.refresh",
          "when": "view == devEnvironments.repositories",
          "group": "navigation@2"
        },
        {
          "command": "devEnvironments.editRepositoryGroups",
          "when": "view == devEnvironments.repositories",
          "group": "1_settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "devEnvironments.start",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/",
          "group": "inline@1"
        },
        {
          "command": "devEnvironments.stop",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStop/",
          "group": "inline@2"
        },
        {
          "command": "devEnvironments.delete",
          "when": "view == devEnvironments.repositories && viewItem =~ /canDelete/",
          "group": "inline@3"
        },
        {
          "submenu": "devEnvironments.more",
          "when": "view == devEnvironments.repositories && viewItem =~ /^repository/",
          "group": "inline@4"
        },
        {
          "command": "devEnvironments.start",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/",
          "group": "1_actions@1"
        },
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/ && !config.devEnvLauncher.openInNewWindow",
          "group": "1_actions@2"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/ && config.devEnvLauncher.openInNewWindow",
          "group": "1_actions@2"
        },
        {
          "command": "devEnvironments.stop",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStop/",
          "group": "1_actions@3"
        },
        {
          "command": "devEnvironments.delete",
          "when": "view == devEnvironments.repositories && viewItem =~ /canDelete/",
          "group": "1_actions@4"
        },
        {
          "command": "devEnvironments.switchBranch",
          "when": "view == devEnvironments.repositories && viewItem =~ /^repository/",
          "group": "2_more@1"
        },
        {
          "command": "devEnvironments.selectConfiguration",
          "when": "view == devEnvironments.repositories && viewItem =~ /multiConfig/",
          "group": "2_more@2"
        },
        {
          "command": "devEnvironments.rebuild",
          "when": "view == devEnvironments.repositories && viewItem =~ /canRebuild/",
          "group": "2_more@3"
        },
        {
          "command": "devEnvironments.showOnGitHub",
          "when": "view == devEnvironments.repositories && viewItem =~ /onGitHub/",
          "group": "2_more@4"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "view == devEnvironments.repositories && viewItem =~ /hostAccessChecked/",
          "group": "3_hostAccess@1"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "view == devEnvironments.repositories && viewItem =~ /hostAccessUnrestricted/",
          "group": "3_hostAccess@1"
        }
      ],
      "devEnvironments.more": [
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "viewItem =~ /canStart/ && !config.devEnvLauncher.openInNewWindow",
          "group": "0_start@1"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "viewItem =~ /canStart/ && config.devEnvLauncher.openInNewWindow",
          "group": "0_start@1"
        },
        {
          "command": "devEnvironments.switchBranch",
          "group": "1_more@1"
        },
        {
          "command": "devEnvironments.selectConfiguration",
          "when": "viewItem =~ /multiConfig/",
          "group": "1_more@2"
        },
        {
          "command": "devEnvironments.rebuild",
          "when": "viewItem =~ /canRebuild/",
          "group": "1_more@3"
        },
        {
          "command": "devEnvironments.showOnGitHub",
          "when": "viewItem =~ /onGitHub/",
          "group": "1_more@4"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "viewItem =~ /hostAccessChecked/",
          "group": "2_hostAccess@1"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "viewItem =~ /hostAccessUnrestricted/",
          "group": "2_hostAccess@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devEnvironments.switchEnvironment",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Dev Environments",
      "properties": {
        "devEnvLauncher.reopenLastOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the last used environment when VS Code starts."
        },
        "devEnvLauncher.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "**Start** opens the environment in a new window, and the current window keeps its environment. **Switch Environment…** does the same. From an empty window, **Start** uses that window. The context menu of a repository then offers **Start in Current Window**. If false, **Start** connects the current window, and the context menu offers **Start in New Window**. An environment that is open in another window is never opened a second time: that window is shown. Only the user settings count."
        },
        "devEnvLauncher.stopOnClose": {
          "type": "boolean",
          "default": true,
          "description": "Stop the environment when no window uses it. If false, the container keeps running."
        },
        "devEnvLauncher.waitingTimeSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Waiting time in seconds before a stop. It prevents a stop during a window reload."
        },
        "devEnvLauncher.updateImagesOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Check for newer images at each connection."
        },
        "devEnvLauncher.respectShutdownActionNone": {
          "type": "boolean",
          "default": false,
          "description": "If true, a repository with \"shutdownAction\": \"none\" keeps its container running after close."
        },
        "devEnvLauncher.owners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Scan only the repositories of these organizations or accounts. An empty list scans all repositories that you can access."
        },
        "devEnvLauncher.includeArchived": {
          "type": "boolean",
          "default": false,
          "description": "Show archived repositories."
        },
        "devEnvLauncher.includeForks": {
          "type": "boolean",
          "default": true,
          "description": "Show forked repositories."
        },
        "devEnvLauncher.refreshIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 35791,
          "description": "Interval in minutes of the background update of the repository list."
        },
        "devEnvLauncher.hostAccessChecksOff": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+\\s*$",
            "patternErrorMessage": "A repository name like owner/name."
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Repositories (`owner/name`) whose host access checks are off. Their configuration, Features, and base image may then use your computer: its files (bind mounts), the Docker socket (full control of Docker and of every other environment), privileged mode, devices and GPUs, published ports on all network addresses, and the volumes of other programs. The checks of account separation, of the GitHub account of the environment, and of options that Dev Environments does not support stay on. Empty: the checks are on for every repository. Only the user settings count. Use **Turn Off Host Access Checks…** in the context menu of a repository."
        },
        "devEnvLauncher.repositoryGroups": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "A regular expression (JavaScript syntax) for the repository name without the owner."
              },
              {
                "type": "object",
                "required": [
                  "pattern"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of a node that holds the groups of this regular expression. Without a name, its groups are shown directly under the owner."
                  },
                  "pattern": {
                    "type": "string",
                    "description": "A regular expression (JavaScript syntax) for the repository name without the owner."
                  },
                  "flags": {
                    "type": "string",
                    "pattern": "^[ius]*$",
                    "description": "Flags of the regular expression: i (ignore case), u (Unicode), s (dot matches line breaks)."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "markdownDescription": "Regular expressions that filter and group the repositories in the sidebar. Each one is matched against the repository name without the owner. In each owner where at least one repository matches, the sidebar hides the repositories that match none (repositories with an environment are always shown); an owner without a match keeps its plain list. Capturing groups become levels of the tree: the first group is the top level, the last group is the label of the repository. A repository goes under the first regular expression that matches. An entry with a `name` gets its own node with that name. Example: `^(\\d{4}-[^-]+-[^-]+)-([^-]+-[^-]+)-(.+)$`. Only the user settings can set this list. [Edit repository groups](command:devEnvironments.editRepositoryGroups) opens an editor with a preview."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "install-local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@devcontainers/cli": "0.89.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
