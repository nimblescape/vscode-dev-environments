{
  "name": "vscode-dev-environments",
  "displayName": "Dev Environments",
  "description": "Open your GitHub repositories in local dev containers with one action.",
  "version": "0.1.0",
  "publisher": "nimblescape",
  "license": "MIT",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/vscode-dev-environments.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/vscode-dev-environments/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "ms-vscode-remote.remote-containers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onResolveRemoteAuthority:attached-container"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devEnvironments",
          "title": "Dev Environments",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "devEnvironments": [
        {
          "id": "devEnvironments.repositories",
          "name": "Dev Environments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devEnvironments.repositories",
        "contents": "Dev Environments needs Docker, which is not installed on this computer.",
        "when": "devEnvironments.dockerSetupRequired"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "1. Install WSL 2, which Docker Desktop needs. Windows asks for administrator permission; restart afterwards.\n[Install WSL 2](command:devEnvironments.dockerSetup.installWsl)",
        "when": "devEnvironments.dockerSetupRequired && isWindows && !devEnvironments.wslReady"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "1. ✓ WSL 2 is installed.",
        "when": "devEnvironments.dockerSetupRequired && isWindows && devEnvironments.wslReady"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Install Docker Desktop with Homebrew or Docker's installer. You see the commands before anything runs. Docker Desktop is free for personal use, education, non-commercial open source, and small businesses; larger companies need a [paid subscription](https://www.docker.com/legal/docker-subscription-service-agreement/).\n[Install Docker](command:devEnvironments.dockerSetup.install)",
        "when": "devEnvironments.dockerSetupRequired && isMac"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "2. Install Docker Desktop with winget or Docker's installer. You see the commands before anything runs. Docker Desktop is free for personal use, education, non-commercial open source, and small businesses; larger companies need a [paid subscription](https://www.docker.com/legal/docker-subscription-service-agreement/).\n[Install Docker](command:devEnvironments.dockerSetup.install)",
        "when": "devEnvironments.dockerSetupRequired && isWindows"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Install Docker Engine from Docker's package repository. You see the commands before anything runs.\n[Install Docker](command:devEnvironments.dockerSetup.install)",
        "when": "devEnvironments.dockerSetupRequired && isLinux"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Your repositories appear here once Docker is installed. Dev Environments starts Docker when needed.",
        "when": "devEnvironments.dockerSetupRequired && !isLinux"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Your repositories appear here once Docker is installed. Dev Environments asks to start Docker Engine when needed.",
        "when": "devEnvironments.dockerSetupRequired && isLinux"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Sign in with GitHub to see your repositories that have a Dev Container configuration.\n[Sign in with GitHub](command:devEnvironments.signIn)",
        "when": "!devEnvironments.signedIn"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "Loading your repositories…",
        "when": "devEnvironments.signedIn && !devEnvironments.loaded && !devEnvironments.dockerSetupRequired"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "No repository with a Dev Container configuration was found.\n[Refresh](command:devEnvironments.refresh)",
        "when": "devEnvironments.signedIn && devEnvironments.loaded && !devEnvironments.loadFailed && !devEnvironments.dockerSetupRequired"
      },
      {
        "view": "devEnvironments.repositories",
        "contents": "The repository list could not be loaded. Check the internet connection and try again.\n[Refresh](command:devEnvironments.refresh)\n[Show Log](command:devEnvironments.showLog)",
        "when": "devEnvironments.signedIn && devEnvironments.loadFailed && !devEnvironments.dockerSetupRequired"
      }
    ],
    "commands": [
      {
        "command": "devEnvironments.start",
        "title": "Start",
        "category": "Dev Environments",
        "icon": "$(play)"
      },
      {
        "command": "devEnvironments.startInNewWindow",
