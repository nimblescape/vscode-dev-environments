    "menus": {
      "commandPalette": [
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "!config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.switchEnvironmentInNewWindow",
          "when": "!config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.switchEnvironmentInCurrentWindow",
          "when": "config.devEnvLauncher.openInNewWindow"
        },
        {
          "command": "devEnvironments.selectOwnersFiltered",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.install",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.start",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.installWsl",
          "when": "false"
        },
        {
          "command": "devEnvironments.dockerSetup.show",
          "when": "false"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "false"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "false"
        },
        {
          "command": "devEnvironments.closeAndKeepRunning",
          "when": "devEnvironments.connected"
        },
        {
          "command": "devEnvironments.rowActivated",
          "when": "false"
        },
        {
          "command": "devEnvironments.showProgressDetails",
          "when": "false"
        },
        {
          "command": "devEnvironments.chooseDockerHost",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "devEnvironments.selectOwners",
          "when": "view == devEnvironments.repositories && !devEnvironments.ownersFiltered",
          "group": "navigation@0"
        },
        {
          "command": "devEnvironments.selectOwnersFiltered",
          "when": "view == devEnvironments.repositories && devEnvironments.ownersFiltered",
          "group": "navigation@0"
        },
        {
          "command": "devEnvironments.search",
          "when": "view == devEnvironments.repositories",
          "group": "navigation@1"
        },
        {
          "command": "devEnvironments.refresh",
          "when": "view == devEnvironments.repositories",
          "group": "navigation@2"
        },
        {
          "command": "devEnvironments.editRepositoryGroups",
          "when": "view == devEnvironments.repositories",
          "group": "1_settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "devEnvironments.start",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/",
          "group": "inline@1"
        },
        {
          "command": "devEnvironments.stop",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStop/",
          "group": "inline@2"
        },
        {
          "command": "devEnvironments.delete",
          "when": "view == devEnvironments.repositories && viewItem =~ /canDelete/",
          "group": "inline@3"
        },
        {
          "submenu": "devEnvironments.more",
          "when": "view == devEnvironments.repositories && viewItem =~ /^repository/",
          "group": "inline@4"
        },
        {
          "command": "devEnvironments.start",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/",
          "group": "1_actions@1"
        },
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/ && !config.devEnvLauncher.openInNewWindow",
          "group": "1_actions@2"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStart/ && config.devEnvLauncher.openInNewWindow",
          "group": "1_actions@2"
        },
        {
          "command": "devEnvironments.stop",
          "when": "view == devEnvironments.repositories && viewItem =~ /canStop/",
          "group": "1_actions@3"
        },
        {
          "command": "devEnvironments.delete",
          "when": "view == devEnvironments.repositories && viewItem =~ /canDelete/",
          "group": "1_actions@4"
        },
        {
          "command": "devEnvironments.keepRunning",
          "when": "view == devEnvironments.repositories && viewItem =~ /;canKeepRunning(;|$)/",
          "group": "1_actions@5"
        },
        {
          "command": "devEnvironments.stopWhenClosed",
          "when": "view == devEnvironments.repositories && viewItem =~ /;kept(;|$)/",
          "group": "1_actions@5"
        },
        {
          "command": "devEnvironments.closeAndKeepRunning",
          "when": "view == devEnvironments.repositories && viewItem =~ /;canCloseAndKeepRunning(;|$)/",
          "group": "1_actions@6"
        },
        {
          "command": "devEnvironments.switchBranch",
          "when": "view == devEnvironments.repositories && viewItem =~ /^repository/",
          "group": "2_more@1"
        },
        {
          "command": "devEnvironments.selectConfiguration",
          "when": "view == devEnvironments.repositories && viewItem =~ /multiConfig/",
          "group": "2_more@2"
        },
        {
          "command": "devEnvironments.rebuild",
          "when": "view == devEnvironments.repositories && viewItem =~ /canRebuild/",
          "group": "2_more@3"
        },
        {
          "command": "devEnvironments.showOnGitHub",
          "when": "view == devEnvironments.repositories && viewItem =~ /onGitHub/",
          "group": "2_more@4"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "view == devEnvironments.repositories && viewItem =~ /hostAccessChecked/",
          "group": "3_hostAccess@1"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "view == devEnvironments.repositories && viewItem =~ /hostAccessUnrestricted/",
          "group": "3_hostAccess@1"
        }
