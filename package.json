      "devEnvironments.more": [
        {
          "command": "devEnvironments.startInNewWindow",
          "when": "viewItem =~ /canStart/ && !config.devEnvLauncher.openInNewWindow",
          "group": "0_start@1"
        },
        {
          "command": "devEnvironments.startInCurrentWindow",
          "when": "viewItem =~ /canStart/ && config.devEnvLauncher.openInNewWindow",
          "group": "0_start@1"
        },
        {
          "command": "devEnvironments.keepRunning",
          "when": "viewItem =~ /;canKeepRunning(;|$)/",
          "group": "1_more@5"
        },
        {
          "command": "devEnvironments.stopWhenClosed",
          "when": "viewItem =~ /;kept(;|$)/",
          "group": "1_more@5"
        },
        {
          "command": "devEnvironments.closeAndKeepRunning",
          "when": "viewItem =~ /;canCloseAndKeepRunning(;|$)/",
          "group": "1_more@6"
        },
        {
          "command": "devEnvironments.switchBranch",
          "group": "1_more@1"
        },
        {
          "command": "devEnvironments.selectConfiguration",
          "when": "viewItem =~ /multiConfig/",
          "group": "1_more@2"
        },
        {
          "command": "devEnvironments.rebuild",
          "when": "viewItem =~ /canRebuild/",
          "group": "1_more@3"
        },
        {
          "command": "devEnvironments.showOnGitHub",
          "when": "viewItem =~ /onGitHub/",
          "group": "1_more@4"
        },
        {
          "command": "devEnvironments.turnOffHostAccessChecks",
          "when": "viewItem =~ /hostAccessChecked/",
          "group": "2_hostAccess@1"
        },
        {
          "command": "devEnvironments.turnOnHostAccessChecks",
          "when": "viewItem =~ /hostAccessUnrestricted/",
          "group": "2_hostAccess@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devEnvironments.switchEnvironment",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Dev Environments",
      "properties": {
        "devEnvLauncher.reopenLastOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the last used environment when VS Code starts."
        },
        "devEnvLauncher.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "**Start** opens the environment in a new window, and the current window keeps its environment. **Switch Environment…** does the same. From an empty window, **Start** uses that window. The context menu of a repository then offers **Start in Current Window**. If false, **Start** connects the current window, and the context menu offers **Start in New Window**. An environment that is open in another window is never opened a second time: that window is shown. Only the user settings count."
        },
        "devEnvLauncher.stopOnClose": {
          "type": "boolean",
          "default": true,
          "description": "Stop an environment when no window uses it, after the waiting time. If false, all environments keep running. To keep only some environments running, use Keep Running When Closed in the context menu of their rows."
        },
        "devEnvLauncher.waitingTimeSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Waiting time in seconds before a stop. It prevents a stop during a window reload."
        },
        "devEnvLauncher.remoteStopAfterMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 1440,
          "description": "Stops a container on a remote Docker host after this many minutes without contact from this computer, for example when it sleeps or is offline. Not for environments that keep running when closed."
        },
        "devEnvLauncher.remoteImageUpdates": {
          "type": "array",
          "scope": "application",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 129,
            "pattern": "^(?=.{1,128}\\*?$)(?!.*\\.\\.)(?!(docker\\.io|index\\.docker\\.io|registry-1\\.docker\\.io)/)([a-z0-9-]+(\\.[a-z0-9-]+)+(:[0-9]+)?|[a-z0-9.-]+:[0-9]+|localhost)/[a-z0-9._/-]*\\*?$",
            "patternErrorMessage": "A repository prefix with its registry, for example ghcr.io/owner/name*. Docker Hub (docker.io) is not supported."
          },
          "default": [
            "ghcr.io/majikmate/devcontainer-classroom*",
            "ghcr.io/majikmate/devcontainer-dev*"
          ],
          "description": "Only on a remote Docker host: the Session Monitor there pulls the latest major version of every image repository that starts with one of these names (for ghcr.io all public packages of the owner, read with your GitHub sign-in), one minute after it starts and then by Remote Image Update Schedule (default every day at 06:07), and keeps the two newest versions of each. Older versions that no container uses are removed. An empty list turns it off; at most 50 patterns."
        },
        "devEnvLauncher.remoteImageUpdateSchedule": {
          "type": "string",
          "scope": "application",
          "default": "7 6 * * *",
          "pattern": "^\\s*\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s*$",
          "patternErrorMessage": "Five fields: minute hour day-of-month month day-of-week, for example 7 6 * * * (every day at 06:07).",
          "examples": [
            "7 6 * * *",
            "7 6 * * 1-5",
            "7 6,18 * * *",
            "7 */6 * * *",
            "7 6 * * 1",
            "7 6 1 * *"
          ],
          "markdownDescription": "Only on a remote Docker host: when the Session Monitor there updates the images of `#devEnvLauncher.remoteImageUpdates#` after its first pass (one minute after it starts). A cron expression of five fields in the time zone of this computer:\n\n| Field | Values |\n|---|---|\n| minute | 0-59 |\n| hour | 0-23 |\n| day of the month | 1-31 |\n| month | 1-12 or JAN-DEC |\n| day of the week | 0-7 or SUN-SAT (0 and 7: Sunday) |\n\nEach field: `*` (any), a number, a range `1-5`, a list `6,18`, a step `*/6`. Examples: `7 6 * * *` every day at 06:07 (the default); `7 6 * * 1-5` Monday to Friday at 06:07; `7 6,18 * * *` at 06:07 and 18:07; `7 */6 * * *` every six hours; `7 6 * * 1` Mondays; `7 6 1 * *` on the first of each month. An invalid expression means the default."
        },
        "devEnvLauncher.updateImagesOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Check for newer images at each connection."
        },
        "devEnvLauncher.respectShutdownActionNone": {
          "type": "boolean",
          "default": false,
          "description": "If true, a repository with \"shutdownAction\": \"none\" keeps its container running after close."
        },
        "devEnvLauncher.owners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Scan only the repositories of these organizations or accounts. An empty list scans all repositories that you can access."
        },
        "devEnvLauncher.includeArchived": {
          "type": "boolean",
          "default": false,
          "description": "Show archived repositories."
        },
        "devEnvLauncher.includeForks": {
          "type": "boolean",
          "default": true,
          "description": "Show forked repositories."
        },
        "devEnvLauncher.refreshIntervalMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 35791,
          "description": "Interval in minutes of the background update of the repository list."
        },
        "devEnvLauncher.hostAccessChecksOff": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+\\s*$",
            "patternErrorMessage": "A repository name like owner/name."
          },
          "default": [],
          "scope": "application",
          "markdownDescription": "Repositories (`owner/name`) whose host access checks are off. Their configuration, Features, and base image may then use your computer: its files (bind mounts), the Docker socket (full control of Docker and of every other environment), privileged mode, devices and GPUs, published ports on all network addresses, and the volumes of other programs. The checks of account separation, of the GitHub account of the environment, and of options that Dev Environments does not support stay on. Empty: the checks are on for every repository. Only the user settings count. Use **Turn Off Host Access Checks…** in the context menu of a repository."
        },
        "devEnvLauncher.repositoryGroups": {
          "type": "array",
          "scope": "application",
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string",
                "description": "A regular expression (JavaScript syntax) for the repository name without the owner."
              },
              {
                "type": "object",
                "required": [
                  "pattern"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of a node that holds the groups of this regular expression. Without a name, its groups are shown directly under the owner."
                  },
                  "pattern": {
                    "type": "string",
                    "description": "A regular expression (JavaScript syntax) for the repository name without the owner."
                  },
                  "flags": {
                    "type": "string",
                    "pattern": "^[ius]*$",
                    "description": "Flags of the regular expression: i (ignore case), u (Unicode), s (dot matches line breaks)."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "markdownDescription": "**[Edit Repository Groups…](command:devEnvironments.editRepositoryGroups)** opens an editor with a preview (VS Code itself only offers settings.json for this setting). Regular expressions that filter and group the repositories in the sidebar. Each one is matched against the repository name without the owner. In each owner where at least one repository matches, the sidebar hides the repositories that match none (repositories with an environment are always shown); an owner without a match keeps its plain list. Capturing groups become levels of the tree: the first group is the top level, the last group is the label of the repository. A repository goes under the first regular expression that matches. An entry with a `name` gets its own node with that name. The nodes are in the order of the entries. Example: `^(\\d{4}-[^-]+-[^-]+)-([^-]+-[^-]+)-(.+)$`. Only the user settings can set this list."
        }
      }
    }
  },
